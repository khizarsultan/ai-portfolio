# Copy to .env and adjust. .env is git-ignored.

# LLM backend: "nvidia" (hosted NIM, free tier) or "ollama" (fully local, zero egress).
LLM_BACKEND=nvidia

# --- NVIDIA NIM (default) --- free key from https://build.nvidia.com (looks like nvapi-...)
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=meta/llama-3.3-70b-instruct

# --- Local Ollama (fallback) --- set LLM_BACKEND=ollama and uncomment:
# MODEL_NAME=qwen3:14b
# OLLAMA_BASE_URL=http://localhost:11434

LLM_MAX_RETRIES=2

# --- Observability: Langfuse (planv4 D) --- feature-flagged; off = safe no-op.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PROJECT_ID=...     # optional; enables exact "View full trace" deep-links
